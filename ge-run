#!/usr/bin/env python3
"""ge-run: claim/release Games Explained game runs via Discord.

Prevents two agents from working the same game at once. Posts human-readable
claim markers to a Discord channel; `claim` refuses if the game is taken.
Matching is done on a normalized form, so "Classic Adventure" and
"classic adventure" count as the same game.

Talks to the Discord REST API directly (stdlib only, no dependencies).

Usage:
  ge-run init                      one-time setup: store bot token + allowlist
  ge-run claim <game> [--agent NAME]    claim a run (fails if already claimed)
  ge-run done  <game> [--agent NAME]    release a run
  ge-run status [game]                  show active claims

Env:
  GE_AGENT           agent name (default from local config, else Bob)
  GE_CLAIMS_CHANNEL  Discord channel id for claims
                     (default: #game-claims 1557564764165636186)
  DISCORD_BOT_TOKEN  bot token (or stored via `ge-run init`)

Token precedence: DISCORD_BOT_TOKEN env, then ~/.config/discord-cli/credentials.json
"""
import json
import os
import re
import sys
import urllib.request
import urllib.error

API = "https://discord.com/api/v10"
CHANNEL = os.environ.get("GE_CLAIMS_CHANNEL", "1557564764165636186")
GE_SERVER = "1552311170780766208"
CFG_DIR = os.path.expanduser("~/.config/discord-cli")
CREDS_PATH = os.path.join(CFG_DIR, "credentials.json")

CLAIM_RE = re.compile(r"^🔒 CLAIM (.+?) — started by (.+)$")
DONE_RE = re.compile(r"^🔓 DONE (.+?) — finished by (.+)$")


def norm(game: str) -> str:
    """Internal matching key: lowercase, alphanumerics only."""
    return re.sub(r"[^a-z0-9]", "", game.strip().lower())


def display(game: str) -> str:
    """Human-readable name, as typed (whitespace tidied)."""
    return re.sub(r"\s+", " ", game.strip())


def load_cfg() -> dict:
    try:
        with open(CREDS_PATH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def token() -> str:
    t = os.environ.get("DISCORD_BOT_TOKEN", "").strip()
    if t:
        return t
    return load_cfg().get("botToken", "").strip()


def default_agent() -> str:
    return os.environ.get("GE_AGENT", "").strip() or load_cfg().get("agent", "Bob")


def render_agent(agent: str) -> str:
    """@mention the agent if the local config maps them to a Discord user id."""
    uid = load_cfg().get("mentions", {}).get(agent)
    return f"<@{uid}>" if uid else agent


def api(method: str, path: str, body: dict | None = None) -> dict | list:
    tok = token()
    if not tok:
        print("no bot token: set DISCORD_BOT_TOKEN or run `ge-run init`",
              file=sys.stderr)
        sys.exit(2)
    req = urllib.request.Request(
        API + path,
        data=json.dumps(body).encode() if body is not None else None,
        method=method,
        headers={"Authorization": f"Bot {tok}",
                 "Content-Type": "application/json",
                 "User-Agent": "ge-run/1.0"},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        detail = e.read().decode()[:200]
        print(f"Discord API {e.code}: {detail}", file=sys.stderr)
        sys.exit(2)


def active_claims(limit: int = 100) -> dict:
    """norm-key -> (display name, agent, timestamp) for claims with no later DONE."""
    msgs = api("GET", f"/channels/{CHANNEL}/messages?limit={limit}")
    claimed: dict = {}
    released: set = set()
    for m in msgs:
        content = m.get("content", "")
        mc = CLAIM_RE.match(content)
        if mc:
            key = norm(mc.group(1))
            if key not in released:
                claimed.setdefault(key, (display(mc.group(1)), mc.group(2),
                                         m.get("timestamp", "")))
            continue
        md = DONE_RE.match(content)
        if md:
            key = norm(md.group(1))
            released.add(key)
            claimed.pop(key, None)
    return claimed


def cmd_claim(game: str, agent: str) -> None:
    name = display(game)
    key = norm(game)
    claims = active_claims()
    if key in claims:
        dname, other, ts = claims[key]
        if other in (agent, render_agent(agent)):
            print(f"already claimed by you ({agent}); continuing")
            return
        print(f"REFUSED: {dname} is already claimed by {other} ({ts})",
              file=sys.stderr)
        sys.exit(1)
    api("POST", f"/channels/{CHANNEL}/messages",
        {"content": f"🔒 CLAIM {name} — started by {render_agent(agent)}"})
    print(f"claimed {name} as {agent}")


def cmd_done(game: str, agent: str) -> None:
    name = display(game)
    api("POST", f"/channels/{CHANNEL}/messages",
        {"content": f"🔓 DONE {name} — finished by {render_agent(agent)}"})
    print(f"released {name}")


def cmd_status(game: str | None) -> None:
    claims = active_claims()
    if game:
        key = norm(game)
        if key in claims:
            name, agent, ts = claims[key]
            print(f"{name}: claimed by {agent} ({ts})")
        else:
            print(f"{display(game)}: free")
    elif claims:
        for _, (name, agent, ts) in sorted(claims.items()):
            print(f"{name}: {agent} ({ts})")
    else:
        print("no active claims")


def cmd_init() -> None:
    os.makedirs(CFG_DIR, exist_ok=True)
    cfg = load_cfg()
    tok = os.environ.get("DISCORD_BOT_TOKEN", "").strip()
    if not tok:
        tok = input("bot token (DM Aaron for it): ").strip()
    cfg["botToken"] = tok
    current = cfg.get("agent", "").strip()
    name = input(f"agent name [{current or 'Bob'}]: ").strip()
    cfg["agent"] = name or current or "Bob"
    with open(CREDS_PATH, "w") as f:
        json.dump(cfg, f)
    os.chmod(CREDS_PATH, 0o600)
    me = api("GET", "/users/@me")
    print(f"authed as {me.get('username')} ({me.get('id')})")
    print(f"claims channel: {CHANNEL} (override with GE_CLAIMS_CHANNEL)")
    print(f"agent: {cfg['agent']} (override with --agent or GE_AGENT)")


def main() -> None:
    raw = sys.argv[1:]
    agent = default_agent()
    args: list = []
    skip = False
    for i, a in enumerate(raw):
        if skip:
            skip = False
            continue
        if a == "--agent" and i + 1 < len(raw):
            agent = raw[i + 1]
            skip = True
        else:
            args.append(a)
    if not args:
        print(__doc__)
        sys.exit(2)
    cmd, *rest = args
    if cmd == "init" and not rest:
        cmd_init()
    elif cmd == "claim" and len(rest) == 1:
        cmd_claim(rest[0], agent)
    elif cmd == "done" and len(rest) == 1:
        cmd_done(rest[0], agent)
    elif cmd == "status" and len(rest) <= 1:
        cmd_status(rest[0] if rest else None)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
